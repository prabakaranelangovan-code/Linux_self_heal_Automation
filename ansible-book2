---
- name: Linux Self-Healing
  hosts: linux_servers
  become: yes
  gather_facts: yes

  tasks:

    - name: Gather service facts
      ansible.builtin.service_facts:

    # Root filesystem check using facts
    - name: Find root mount details
      ansible.builtin.set_fact:
        root_mount: "{{ ansible_facts.mounts | selectattr('mount', 'equalto', '/') | first }}"

    - name: Warn if root free space is low
      ansible.builtin.debug:
        msg: "Warning: Low disk space on root partition"
      when: (root_mount.size_available / 1024 / 1024 / 1024) < 5

    # Memory check using facts
    - name: Display free memory
      ansible.builtin.debug:
        msg: "Free memory: {{ ansible_memfree_mb }} MB"

    - name: Warn if memory is low
      ansible.builtin.debug:
        msg: "Warning: Low available memory"
      when: ansible_memfree_mb < 500

    # Load check using facts
    - name: Display system load
      ansible.builtin.debug:
        msg: "Current load average: {{ ansible_loadavg['1m'] }}"

    - name: Warn if CPU load is high
      ansible.builtin.debug:
        msg: "Warning: High system load detected"
      when: ansible_loadavg['1m'] | float > 5

    # Ensure critical services are running
    - name: Ensure rsyslog is running
      ansible.builtin.systemd:
        name: rsyslog
        state: started
      ignore_errors: true

    - name: Ensure cron service is running (Ubuntu)
      ansible.builtin.systemd:
        name: cron
        state: started
      ignore_errors: true

    - name: Ensure crond service is running (RHEL)
      ansible.builtin.systemd:
        name: crond
        state: started
      ignore_errors: true

    # Temporary file cleanup
    - name: Find old files in /tmp
      ansible.builtin.find:
        paths: /tmp
        age: 7d
        file_type: file
      register: old_tmp_files

    - name: Remove old files from /tmp
      ansible.builtin.file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ old_tmp_files.files }}"
